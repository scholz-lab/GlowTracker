#:kivy 2.0
# Layout of the AI assistant window (assistant_window.py).

<AssistantWidget>:
    size: root.size
    pos: root.pos
    orientation: 'vertical'
    padding: dp(8), dp(6)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0.075, 0.08, 0.09, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(30)
        spacing: dp(4)

        Label:
            id: header
            markup: True
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            shorten: True
            font_size: '14sp'

        Button:
            text: 'Memory'
            size_hint_x: None
            width: dp(76)
            font_size: '13sp'
            background_normal: ''
            background_color: 0.17, 0.18, 0.21, 1
            on_release: root.showMemory()

        Button:
            text: 'Models'
            size_hint_x: None
            width: dp(72)
            font_size: '13sp'
            background_normal: ''
            background_color: 0.17, 0.18, 0.21, 1
            on_release: root.listModels()

        Button:
            text: 'New chat'
            size_hint_x: None
            width: dp(84)
            font_size: '13sp'
            background_normal: ''
            background_color: 0.17, 0.18, 0.21, 1
            on_release: root.newChat()

    ScrollView:
        id: chatscroll
        do_scroll_x: False
        bar_width: dp(6)
        bar_color: 0.5, 0.5, 0.55, 0.8
        bar_inactive_color: 0.4, 0.4, 0.45, 0.4
        scroll_type: ['bars', 'content']

        BoxLayout:
            id: chatlog
            orientation: 'vertical'
            size_hint_y: None
            # At least the visible height, so a short conversation starts at the top.
            height: max(self.minimum_height, chatscroll.height)
            spacing: dp(12)
            padding: dp(4), dp(8), dp(10), dp(8)

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: max(dp(46), min(dp(150), message.minimum_height))
        spacing: dp(6)

        ChatInput:
            id: message
            hint_text: 'Message the assistant'

        Button:
            id: sendbutton
            text: 'Stop' if root.busy else 'Send'
            size_hint: None, None
            size: dp(76), dp(46)
            pos_hint: {'y': 0}
            bold: True
            background_normal: ''
            background_color: (0.55, 0.22, 0.22, 1) if root.busy else (0.18, 0.38, 0.68, 1)
            disabled: not root.busy and not message.text.strip()
            on_release: root.sendOrStop()

    Label:
        size_hint_y: None
        height: dp(14)
        text: 'Enter to send, Shift+Enter for a new line. Nothing is applied until you approve it.'
        font_size: '11sp'
        color: 0.5, 0.5, 0.55, 1
        halign: 'left'
        text_size: self.size
        shorten: True


<ChatInput>:
    multiline: True
    write_tab: False
    font_size: '14sp'
    padding: dp(10), dp(12)
    background_normal: ''
    background_active: ''
    background_color: 0.14, 0.15, 0.17, 1
    foreground_color: 0.95, 0.95, 0.95, 1
    cursor_color: 0.6, 0.8, 1, 1
    hint_text_color: 0.5, 0.5, 0.55, 1


<ChatText@Label>:
    size_hint_y: None
    height: self.texture_size[1]
    text_size: self.width, None
    halign: 'left'
    valign: 'top'
    markup: True
    font_size: '14sp'
    line_height: 1.15
    color: 0.92, 0.92, 0.93, 1


<ChatCode@TextInput>:
    readonly: True
    size_hint_y: None
    height: self.minimum_height
    font_name: 'RobotoMono-Regular'
    font_size: '13sp'
    padding: dp(10), dp(8)
    background_normal: ''
    background_active: ''
    background_color: 0.105, 0.11, 0.125, 1
    foreground_color: 0.9, 0.88, 0.82, 1
    cursor_color: 0, 0, 0, 0


<UserBubble>:
    size_hint: None, None
    markup: True
    font_size: '14sp'
    padding: dp(12), dp(8)
    color: 1, 1, 1, 1
    canvas.before:
        Color:
            rgba: 0.18, 0.36, 0.64, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12), dp(12), dp(3), dp(12)]


<UserRow>:
    orientation: 'horizontal'
    size_hint_y: None


<AssistantTurn>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: dp(8)
    padding: 0, 0, dp(24), 0


<MessageBody>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: dp(8)


<TypingIndicator@Label>:
    size_hint_y: None
    height: dp(22)
    text: '•  •  •'
    font_size: '16sp'
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    color: 0.6, 0.6, 0.65, 1
    running: True
    tick: lambda phase: setattr(self, 'color', (0.6, 0.6, 0.65, (0.35, 0.65, 1.0)[phase % 3]))


<ThinkingBlock>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: dp(4)

    Button:
        text: root.header + ('  ·  hide' if root.is_open else '  ·  show')
        size_hint: None, None
        size: self.texture_size[0] + dp(4), dp(22)
        font_size: '12.5sp'
        italic: True
        color: 0.62, 0.62, 0.68, 1
        background_normal: ''
        background_down: ''
        background_color: 0, 0, 0, 0
        on_release: root.toggle()

    Label:
        id: content
        size_hint_y: None
        height: self.texture_size[1] if root.is_open else 0
        opacity: 1 if root.is_open else 0
        text_size: self.width - dp(12), None
        markup: True
        font_size: '12.5sp'
        italic: True
        halign: 'left'
        color: 0.62, 0.62, 0.68, 1
        padding: dp(12), 0
        canvas.before:
            Color:
                rgba: (0.3, 0.3, 0.35, 1) if root.is_open else (0, 0, 0, 0)
            Rectangle:
                pos: self.x, self.y
                size: dp(2), self.height


<ToolChip>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: dp(10), dp(6)
    spacing: dp(4)
    canvas.before:
        Color:
            rgba: {'running': (0.15, 0.17, 0.21, 1), 'waiting': (0.24, 0.2, 0.12, 1), 'ok': (0.13, 0.19, 0.15, 1), 'failed': (0.22, 0.15, 0.14, 1)}[root.state]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]

    Button:
        text: {'running': '[color=8fb7ff]•[/color]  ', 'waiting': '[color=f0c27b]•[/color]  ', 'ok': '[color=7fd88f]•[/color]  ', 'failed': '[color=ff8a7a]•[/color]  '}[root.state] + root.header
        markup: True
        size_hint_y: None
        height: self.texture_size[1] + dp(2)
        text_size: self.width, None
        halign: 'left'
        font_size: '13sp'
        color: 0.85, 0.86, 0.9, 1
        background_normal: ''
        background_down: ''
        background_color: 0, 0, 0, 0
        on_release: root.toggle()

    Label:
        id: details
        size_hint_y: None
        height: self.texture_size[1] if root.is_open else 0
        opacity: 1 if root.is_open else 0
        text_size: self.width, None
        halign: 'left'
        font_name: 'RobotoMono-Regular'
        font_size: '11.5sp'
        color: 0.7, 0.7, 0.75, 1


<ChatEmptyState@BoxLayout>:
    # Its height is set to the visible chat height, so the spacers centre the content.
    orientation: 'vertical'
    size_hint_y: None
    spacing: dp(8)
    padding: dp(4), dp(8)

    Widget:

    Label:
        size_hint_y: None
        height: self.texture_size[1]
        text_size: self.width, None
        halign: 'center'
        markup: True
        font_size: '15sp'
        text: '[b]What should the experiment do?[/b]'

    Label:
        size_hint_y: None
        height: self.texture_size[1] + dp(8)
        text_size: self.width, None
        halign: 'center'
        font_size: '13sp'
        color: 0.6, 0.6, 0.65, 1
        text: 'Describe light timing or behaviour-triggered stimulation in plain words. The assistant writes a sequencer script or a plugin, checks it, and shows it to you for review. Set the API in GlowTracker: Settings > AI assistant. Keep this window open while you run experiments.'

    Label:
        id: reminder
        size_hint_y: None
        height: self.texture_size[1] + dp(4) if self.text else 0
        text_size: self.width, None
        halign: 'center'
        markup: True
        font_size: '13sp'

    BoxLayout:
        id: suggestions
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(6)

    Widget:


<ChatSuggestion@Button>:
    size_hint_y: None
    height: self.texture_size[1] + dp(16)
    text_size: self.width - dp(24), None
    halign: 'left'
    font_size: '13sp'
    color: 0.85, 0.87, 0.92, 1
    background_normal: ''
    background_color: 0.14, 0.15, 0.18, 1


<ProposalCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: dp(10), dp(8)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0.13, 0.16, 0.21, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: 0.25, 0.42, 0.7, 1
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(10)
            width: 1

    Label:
        id: title
        size_hint_y: None
        height: self.texture_size[1] + dp(2)
        text_size: self.width, None
        halign: 'left'
        markup: True
        font_size: '13sp'

    CodeInput:
        id: code
        do_wrap: False
        size_hint_y: None
        height: min(dp(280), self.minimum_height)
        font_name: 'RobotoMono-Regular'
        font_size: '13sp'
        style_name: 'monokai'
        background_normal: ''
        background_active: ''
        background_color: 0.105, 0.11, 0.125, 1
        foreground_color: 0.92, 0.9, 0.85, 1
        cursor_color: 0.6, 0.8, 1, 1
        padding: dp(10), dp(8)

    Label:
        id: checks
        size_hint_y: None
        height: self.texture_size[1] if self.text else 0
        text_size: self.width, None
        halign: 'left'
        markup: True
        font_size: '12sp'
        color: 0.68, 0.72, 0.78, 1

    BoxLayout:
        id: actions
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(34)
        spacing: dp(6)

        TextInput:
            id: path
            multiline: False
            font_size: '12sp'
            padding: dp(8), dp(9)

        Button:
            id: usebutton
            size_hint_x: None
            width: max(dp(170), self.texture_size[0] + dp(24))
            bold: True
            font_size: '13sp'
            background_normal: ''
            background_color: 0.18, 0.38, 0.68, 1
            on_release: root.approve()

        Button:
            id: declinebutton
            text: 'Decline'
            size_hint_x: None
            width: dp(84)
            font_size: '13sp'
            background_normal: ''
            background_color: 0.3, 0.2, 0.2, 1
            on_release: root.decline()

    Label:
        id: status
        size_hint_y: None
        height: self.texture_size[1] if self.text else 0
        text_size: self.width, None
        halign: 'left'
        font_size: '12sp'




<MemoryCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: dp(10), dp(8)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0.16, 0.14, 0.2, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: 0.55, 0.42, 0.75, 1
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(10)
            width: 1

    Label:
        id: title
        size_hint_y: None
        height: self.texture_size[1] + dp(2)
        text_size: self.width, None
        halign: 'left'
        markup: True
        font_size: '13sp'

    TextInput:
        id: fact
        size_hint_y: None
        height: max(dp(40), self.minimum_height)
        font_size: '14sp'
        padding: dp(10), dp(8)
        background_normal: ''
        background_active: ''
        background_color: 0.105, 0.11, 0.125, 1
        foreground_color: 0.93, 0.93, 0.95, 1
        cursor_color: 0.6, 0.8, 1, 1

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(34)
        spacing: dp(6)

        Widget:

        Button:
            id: approvebutton
            size_hint_x: None
            width: max(dp(120), self.texture_size[0] + dp(24))
            bold: True
            font_size: '13sp'
            background_normal: ''
            background_color: 0.42, 0.3, 0.62, 1
            on_release: root.approve()

        Button:
            id: declinebutton
            text: 'Decline'
            size_hint_x: None
            width: dp(84)
            font_size: '13sp'
            background_normal: ''
            background_color: 0.3, 0.2, 0.2, 1
            on_release: root.decline()

    Label:
        id: status
        size_hint_y: None
        height: self.texture_size[1] if self.text else 0
        text_size: self.width, None
        halign: 'left'
        font_size: '12sp'


<MemoryList>:
    orientation: 'vertical'
    spacing: dp(8)

    Label:
        id: where
        size_hint_y: None
        height: self.texture_size[1] + dp(4)
        text_size: self.width, None
        halign: 'left'
        markup: True
        font_size: '11sp'
        color: 0.55, 0.55, 0.6, 1

    ScrollView:
        do_scroll_x: False

        BoxLayout:
            id: rows
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(6)

    Button:
        text: 'Close'
        size_hint_y: None
        height: dp(40)
        on_release: root.close()


<MemoryRow@BoxLayout>:
    orientation: 'horizontal'
    size_hint_y: None
    height: max(dp(40), text.texture_size[1] + dp(12))
    spacing: dp(8)
    padding: dp(6), dp(4)
    canvas.before:
        Color:
            rgba: 0.14, 0.15, 0.18, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]

    Label:
        id: text
        text_size: self.width, None
        halign: 'left'
        valign: 'middle'
        markup: True
        font_size: '13sp'

    Button:
        id: delete
        text: 'Delete'
        size_hint: None, None
        size: dp(70), dp(30)
        pos_hint: {'center_y': .5}
        font_size: '12sp'
        background_normal: ''
        background_color: 0.3, 0.2, 0.2, 1
