#:kivy 2.0
# Layout of the AI assistant window (assistant_window.py).
# Its own process, so its colours and button style are defined here (they match layout.kv).
#:set A_TEXT (0.92, 0.92, 0.94, 1)
#:set A_MUTED (0.6, 0.6, 0.65, 1)
#:set A_BUTTON (0.2, 0.21, 0.24, 1)
#:set A_INPUT (0.14, 0.15, 0.17, 1)
#:set A_BLUE (0.04, 0.52, 1, 1)
#:set A_PURPLE (0.5, 0.36, 0.82, 1)

# A rounded key: `tint` is its colour (dimmed while pressed or disabled), `radius` its corners
<ChatButton@Button>:
    font_size: '13sp'
    color: A_TEXT
    tint: A_BUTTON
    radius: dp(8)
    background_normal: ''
    background_down: ''
    background_disabled_normal: ''
    background_disabled_down: ''
    background_color: 0, 0, 0, 0
    disabled_color: A_MUTED
    canvas.before:
        Color:
            rgba: list((self.tint or A_BUTTON)[:3]) + [0.4 if self.disabled else (0.72 if self.state == 'down' else 1)]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius or dp(8)]

# A pill in the header
<HeaderPill@ChatButton>:
    size_hint: None, None
    height: dp(30)
    width: self.texture_size[0] + dp(28)
    radius: dp(15)
    font_size: '12.5sp'
    pos_hint: {'center_y': .5}

# A rounded dark field with a thin blue outline while typing
<ChatField@TextInput>:
    font_size: '13sp'
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: A_TEXT
    hint_text_color: A_MUTED
    cursor_color: A_BLUE
    cursor_width: dp(1.5)
    canvas.before:
        Color:
            rgba: 0.105, 0.11, 0.125, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: (0.04, 0.52, 1, 0.9) if self.focus else (1, 1, 1, 0.06)
        Line:
            rounded_rectangle: self.x + dp(0.5), self.y + dp(0.5), self.width - dp(1), self.height - dp(1), dp(8)
            width: dp(1.1)
        # Kivy draws the cursor right after its own background, under ours: draw it again on top
        Color:
            rgba: (self.cursor_color if self.focus and not self._cursor_blink and int(self.x + self.padding[0]) <= self._cursor_visual_pos[0] <= int(self.x + self.width - self.padding[2]) else (0, 0, 0, 0))
        Rectangle:
            pos: self._cursor_visual_pos
            size: self.cursor_width, -self._cursor_visual_height
        # the field draws its text with the current colour
        Color:
            rgba: A_TEXT if self.text else A_MUTED

<AssistantWidget>:
    size: root.size
    pos: root.pos
    orientation: 'vertical'
    padding: dp(8), dp(6)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0.075, 0.08, 0.09, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(38)
        spacing: dp(6)
        padding: dp(4), 0

        Label:
            id: header
            markup: True
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            shorten: True
            font_size: '14sp'

        HeaderPill:
            text: 'Memory'
            on_release: root.showMemory()

        HeaderPill:
            text: 'Models'
            on_release: root.listModels()

        HeaderPill:
            text: 'New chat'
            on_release: root.newChat()

    ScrollView:
        id: chatscroll
        do_scroll_x: False
        bar_width: dp(6)
        bar_color: 0.5, 0.5, 0.55, 0.8
        bar_inactive_color: 0.4, 0.4, 0.45, 0.4
        scroll_type: ['bars', 'content']

        BoxLayout:
            id: chatlog
            orientation: 'vertical'
            size_hint_y: None
            # At least the visible height, so a short conversation starts at the top.
            height: max(self.minimum_height, chatscroll.height)
            spacing: dp(12)
            padding: dp(4), dp(8), dp(10), dp(8)

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: max(dp(46), min(dp(150), message.minimum_height))
        spacing: dp(6)

        ChatInput:
            id: message
            hint_text: 'Message the assistant'

        # round send key: an arrow up, or a stop square while the assistant works
        Button:
            id: sendbutton
            text: ''
            size_hint: None, None
            size: dp(46), dp(46)
            pos_hint: {'y': 0}
            background_normal: ''
            background_down: ''
            background_disabled_normal: ''
            background_disabled_down: ''
            background_color: 0, 0, 0, 0
            disabled: not root.busy and not message.text.strip()
            on_release: root.sendOrStop()
            canvas.before:
                Color:
                    rgba: (0.85, 0.25, 0.27, 1) if root.busy else ((0.25, 0.26, 0.29, 1) if self.disabled else A_BLUE)
                    a: 0.75 if self.state == 'down' else 1
                Ellipse:
                    pos: self.center_x - dp(19), self.center_y - dp(19)
                    size: dp(38), dp(38)
                Color:
                    rgba: 1, 1, 1, (1 if root.busy else 0)
                RoundedRectangle:
                    pos: self.center_x - dp(6), self.center_y - dp(6)
                    size: dp(12), dp(12)
                    radius: [dp(2)]
                Color:
                    rgba: 1, 1, 1, (0 if root.busy else (0.45 if self.disabled else 1))
                Line:
                    points: self.center_x, self.center_y - dp(8), self.center_x, self.center_y + dp(8)
                    width: dp(1.6)
                    cap: 'round'
                Line:
                    points: self.center_x - dp(6), self.center_y + dp(2), self.center_x, self.center_y + dp(8), self.center_x + dp(6), self.center_y + dp(2)
                    width: dp(1.6)
                    cap: 'round'
                    joint: 'round'



<ChatInput>:
    multiline: True
    write_tab: False
    font_size: '14sp'
    padding: dp(14), dp(13)
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: 0.95, 0.95, 0.95, 1
    cursor_color: A_BLUE
    cursor_width: dp(1.5)
    hint_text_color: 0.5, 0.5, 0.55, 1
    canvas.before:
        Color:
            rgba: A_INPUT
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: (0.04, 0.52, 1, 0.9) if self.focus else (1, 1, 1, 0.06)
        Line:
            rounded_rectangle: self.x + dp(0.5), self.y + dp(0.5), self.width - dp(1), self.height - dp(1), dp(14)
            width: dp(1.1)
        # Kivy draws the cursor right after its own background, under ours: draw it again on top
        Color:
            rgba: (self.cursor_color if self.focus and not self._cursor_blink and int(self.x + self.padding[0]) <= self._cursor_visual_pos[0] <= int(self.x + self.width - self.padding[2]) else (0, 0, 0, 0))
        Rectangle:
            pos: self._cursor_visual_pos
            size: self.cursor_width, -self._cursor_visual_height
        # the field draws its text with the current colour
        Color:
            rgba: (0.95, 0.95, 0.95, 1) if self.text else (0.5, 0.5, 0.55, 1)


<ChatText@Label>:
    size_hint_y: None
    height: self.texture_size[1]
    text_size: self.width, None
    halign: 'left'
    valign: 'top'
    markup: True
    font_size: '14sp'
    line_height: 1.15
    color: 0.92, 0.92, 0.93, 1


<ChatCode@TextInput>:
    readonly: True
    size_hint_y: None
    height: self.minimum_height
    font_name: 'RobotoMono-Regular'
    font_size: '13sp'
    padding: dp(10), dp(8)
    background_normal: ''
    background_active: ''
    background_color: 0.105, 0.11, 0.125, 1
    foreground_color: 0.9, 0.88, 0.82, 1
    cursor_color: 0, 0, 0, 0


<UserBubble>:
    size_hint: None, None
    markup: True
    font_size: '14sp'
    padding: dp(12), dp(8)
    color: 1, 1, 1, 1
    canvas.before:
        Color:
            rgba: 0.18, 0.36, 0.64, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12), dp(12), dp(3), dp(12)]


<UserRow>:
    orientation: 'horizontal'
    size_hint_y: None


<AssistantTurn>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: dp(8)
    padding: 0, 0, dp(24), 0


<MessageBody>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: dp(8)


<TypingIndicator@Label>:
    size_hint_y: None
    height: dp(22)
    text: '•  •  •'
    font_size: '16sp'
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    color: 0.6, 0.6, 0.65, 1
    running: True
    tick: lambda phase: setattr(self, 'color', (0.6, 0.6, 0.65, (0.35, 0.65, 1.0)[phase % 3]))


<ThinkingBlock>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: dp(4)

    Button:
        text: root.header + ('  ·  hide' if root.is_open else '  ·  show')
        size_hint: None, None
        size: self.texture_size[0] + dp(4), dp(22)
        font_size: '12.5sp'
        italic: True
        color: 0.62, 0.62, 0.68, 1
        background_normal: ''
        background_down: ''
        background_color: 0, 0, 0, 0
        on_release: root.toggle()

    Label:
        id: content
        size_hint_y: None
        height: self.texture_size[1] if root.is_open else 0
        opacity: 1 if root.is_open else 0
        text_size: self.width - dp(12), None
        markup: True
        font_size: '12.5sp'
        italic: True
        halign: 'left'
        color: 0.62, 0.62, 0.68, 1
        padding: dp(12), 0
        canvas.before:
            Color:
                rgba: (0.3, 0.3, 0.35, 1) if root.is_open else (0, 0, 0, 0)
            Rectangle:
                pos: self.x, self.y
                size: dp(2), self.height


<ToolChip>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: dp(10), dp(6)
    spacing: dp(4)
    canvas.before:
        Color:
            rgba: {'running': (0.15, 0.17, 0.21, 1), 'waiting': (0.24, 0.2, 0.12, 1), 'ok': (0.13, 0.19, 0.15, 1), 'failed': (0.22, 0.15, 0.14, 1)}[root.state]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]

    Button:
        text: {'running': '[color=8fb7ff]•[/color]  ', 'waiting': '[color=f0c27b]•[/color]  ', 'ok': '[color=7fd88f]•[/color]  ', 'failed': '[color=ff8a7a]•[/color]  '}[root.state] + root.header
        markup: True
        size_hint_y: None
        height: self.texture_size[1] + dp(2)
        text_size: self.width, None
        halign: 'left'
        font_size: '13sp'
        color: 0.85, 0.86, 0.9, 1
        background_normal: ''
        background_down: ''
        background_color: 0, 0, 0, 0
        on_release: root.toggle()

    Label:
        id: details
        size_hint_y: None
        height: self.texture_size[1] if root.is_open else 0
        opacity: 1 if root.is_open else 0
        text_size: self.width, None
        halign: 'left'
        font_name: 'RobotoMono-Regular'
        font_size: '11.5sp'
        color: 0.7, 0.7, 0.75, 1


<ChatEmptyState@BoxLayout>:
    # Its height is set to the visible chat height, so the spacers centre the content.
    orientation: 'vertical'
    size_hint_y: None
    spacing: dp(8)
    padding: dp(4), dp(8)

    Widget:

    Label:
        size_hint_y: None
        height: self.texture_size[1]
        text_size: self.width, None
        halign: 'center'
        markup: True
        font_size: '15sp'
        text: '[b]What should the experiment do?[/b]'

    Label:
        id: reminder
        size_hint_y: None
        height: self.texture_size[1] + dp(4) if self.text else 0
        text_size: self.width, None
        halign: 'center'
        markup: True
        font_size: '13sp'

    BoxLayout:
        id: suggestions
        orientation: 'vertical'
        size_hint_y: None
        height: self.minimum_height
        spacing: dp(6)

    Widget:


<ChatSuggestion@ChatButton>:
    size_hint_y: None
    height: self.texture_size[1] + dp(20)
    text_size: self.width - dp(28), None
    halign: 'left'
    color: 0.85, 0.87, 0.92, 1
    tint: A_INPUT
    radius: dp(10)


<ProposalCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: dp(10), dp(8)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0.13, 0.16, 0.21, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: 0.25, 0.42, 0.7, 1
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(10)
            width: 1

    Label:
        id: title
        size_hint_y: None
        height: self.texture_size[1] + dp(2)
        text_size: self.width, None
        halign: 'left'
        markup: True
        font_size: '13sp'

    CodeInput:
        id: code
        do_wrap: False
        size_hint_y: None
        height: min(dp(280), self.minimum_height)
        font_name: 'RobotoMono-Regular'
        font_size: '13sp'
        style_name: 'monokai'
        background_normal: ''
        background_active: ''
        background_color: 0.105, 0.11, 0.125, 1
        foreground_color: 0.92, 0.9, 0.85, 1
        cursor_color: 0.6, 0.8, 1, 1
        padding: dp(10), dp(8)

    Label:
        id: checks
        size_hint_y: None
        height: self.texture_size[1] if self.text else 0
        text_size: self.width, None
        halign: 'left'
        markup: True
        font_size: '12sp'
        color: 0.68, 0.72, 0.78, 1

    ScriptPreview:
        id: preview
        size_hint_y: None
        height: dp(340)

    BoxLayout:
        id: actions
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(36)
        spacing: dp(8)

        ChatField:
            id: path
            multiline: False
            font_size: '12sp'
            padding: dp(10), (self.height - self.line_height) / 2

        ChatButton:
            id: declinebutton
            text: 'Decline'
            size_hint_x: None
            width: dp(90)
            on_release: root.decline()

        ChatButton:
            id: usebutton
            size_hint_x: None
            width: max(dp(120), self.texture_size[0] + dp(32))
            bold: True
            tint: A_BLUE
            on_release: root.approve()

    Label:
        id: status
        size_hint_y: None
        height: self.texture_size[1] if self.text else 0
        text_size: self.width, None
        halign: 'left'
        font_size: '12sp'




<MemoryCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: dp(10), dp(8)
    spacing: dp(6)
    canvas.before:
        Color:
            rgba: 0.16, 0.14, 0.2, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]
        Color:
            rgba: 0.55, 0.42, 0.75, 1
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, dp(10)
            width: 1

    Label:
        id: title
        size_hint_y: None
        height: self.texture_size[1] + dp(2)
        text_size: self.width, None
        halign: 'left'
        markup: True
        font_size: '13sp'

    ChatField:
        id: fact
        size_hint_y: None
        height: max(dp(40), self.minimum_height)
        font_size: '14sp'
        padding: dp(10), dp(8)

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(36)
        spacing: dp(8)

        Widget:

        ChatButton:
            id: declinebutton
            text: 'Decline'
            size_hint_x: None
            width: dp(90)
            on_release: root.decline()

        ChatButton:
            id: approvebutton
            size_hint_x: None
            width: max(dp(120), self.texture_size[0] + dp(32))
            bold: True
            tint: A_PURPLE
            on_release: root.approve()

    Label:
        id: status
        size_hint_y: None
        height: self.texture_size[1] if self.text else 0
        text_size: self.width, None
        halign: 'left'
        font_size: '12sp'


<MemoryList>:
    orientation: 'vertical'
    spacing: dp(8)
    padding: dp(8), 0     # in line with the popup title

    Label:
        id: where
        size_hint_y: None
        height: self.texture_size[1] + dp(4)
        text_size: self.width, None
        halign: 'left'
        markup: True
        font_size: '11sp'
        color: 0.55, 0.55, 0.6, 1

    ScrollView:
        do_scroll_x: False

        BoxLayout:
            id: rows
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(6)

    BoxLayout:
        size_hint_y: None
        height: dp(38)

        Widget:

        ChatButton:
            text: 'Close'
            size_hint_x: None
            width: dp(110)
            on_release: root.close()


<MemoryRow@BoxLayout>:
    orientation: 'horizontal'
    size_hint_y: None
    height: max(dp(40), text.texture_size[1] + dp(12))
    spacing: dp(8)
    padding: dp(6), dp(4)
    canvas.before:
        Color:
            rgba: A_INPUT
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]

    Label:
        id: text
        text_size: self.width, None
        halign: 'left'
        valign: 'middle'
        markup: True
        font_size: '13sp'

    ChatButton:
        id: delete
        text: 'Delete'
        size_hint: None, None
        size: dp(72), dp(30)
        pos_hint: {'center_y': .5}
        font_size: '12sp'
        color: 1, 0.45, 0.45, 1
        tint: 0.24, 0.17, 0.18, 1
